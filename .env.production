# Production Environment Variables for MamaCare Web App
# This file is used when deploying to Firebase Hosting

# API Configuration - Set this to your deployed backend URL
# Example: VITE_API_URL=https://your-backend-domain.com/api
VITE_API_URL=https://your-backend-domain.com/api

# Google OAuth Configuration (if needed)
# VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE